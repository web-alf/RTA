ll id="n8" value="NestJS API (modular monolith)&lt;br&gt;&lt;br&gt;auth · users/roles · branches · students&lt;br&gt;families · classes · memorization&lt;br&gt;billing/payments · lps · reports/export&lt;br&gt;import · audit · storage" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=14;fillColor=#ad1d8e;strokeColor=#7d1566;fontColor=#ffffff;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="380" y="330" width="300" height="170" as="geometry"/></mxCell><mxCell id="n9" value="Supabase PostgreSQL&lt;br&gt;(database saja)&lt;br&gt;RLS deny-by-default; migrasi dikelola di repo" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=14;fillColor=#eef1f5;strokeColor=#64748b;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="820" y="130" width="250" height="84" as="geometry"/></mxCell><mxCell id="n10" value="Storage privat&lt;br&gt;bukti pembayaran (terkompresi)&lt;br&gt;akses lewat signed URL berumur pendek" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=14;fillColor=#eef1f5;strokeColor=#64748b;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="820" y="280" width="250" height="84" as="geometry"/></mxCell><mxCell id="n11" value="Scheduler&lt;br&gt;tagihan otomatis tgl 1 · pengingat tgl 10&lt;br&gt;backup harian" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=14;fillColor=#eef1f5;strokeColor=#64748b;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="820" y="430" width="250" height="84" as="geometry"/></mxCell><mxCell id="n12" value="Backup harian: pg_dump ke storage terpisah&lt;br&gt;+ uji pemulihan berkala" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=14;fillColor=#eef1f5;strokeColor=#64748b;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="820" y="580" width="250" height="70" as="geometry"/></mxCell><mxCell id="n13" value="WhatsApp (wa.me)&lt;br&gt;ustadzah kirim manual&lt;br&gt;Fase 4: otomatis via CekatAI" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize