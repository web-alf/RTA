 source="n11" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n22" value="Role inti (Admin Sistem, PJ RTA) tidak bisa dihapus dan PJ tidak bisa mencabut aksesnya sendiri. Hak akses selalu dibatasi lagi oleh scope cabang di sisi server, bukan hanya menyembunyikan menu di tampilan." style="shape=note;whiteSpace=wrap;html=1;fontSize=11;size=14;fillColor=#fffbe6;strokeColor=#b9a24a;align=left;spacingLeft=8;spacingRight=6;fontColor=#3a3200;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="520" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="15. Akun" id="15. Akun"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Menu Akun" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontStyle=1;fontColor=#7d1566;" vertex="1" parent="1"><mxGeometry x="0" y="8" width="700" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Sesuai alur Anda: buka menu akun → input register akun (nama, email, password, role) → validasi → simpan." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#6b5766;" vertex="1" parent="1"><mxGeometry x="0" y="44" width="900" height="24" as="geometry"/></mxCell><mxCell id="lg0" value="Mulai / selesai" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ad1d8e;strokeColor=#7d1566;fontColor=#ffffff;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="74" width="122" height="24" as="geometry"/></mxCell><mxCell id="lg1" value="Langkah" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=14;fillColor=#fbeaf7;strokeColor=#ad1d8e;fontColor=#2d0b26;fontSize=10;" vertex="1" parent="1"><mxGeometry x="130" y="74" width="122" height="24" as="geometry"/></mxCell><mxCell id="lg2" value="Keputusan" style="