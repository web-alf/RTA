kait, termasuk di hasil ekspor. Data santri tidak pernah dihapus permanen." style="shape=note;whiteSpace=wrap;html=1;fontSize=11;size=14;fillColor=#fffbe6;strokeColor=#b9a24a;align=left;spacingLeft=8;spacingRight=6;fontColor=#3a3200;" vertex="1" parent="1"><mxGeometry x="740" y="790" width="540" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="11. Status Santri" id="11. Status Santri"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Status Santri: Cuti, Keluar, Mutasi (tambahan dari aturan PJ)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontStyle=1;fontColor=#7d1566;" vertex="1" parent="1"><mxGeometry x="0" y="8" width="700" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Cuti dicatat langsung ustadzah. Keluar dan mutasi wajib disetujui PJ RTA. Dari menu Manajemen Santri." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#6b5766;" vertex="1" parent="1"><mxGeometry x="0" y="44" width="900" height="24" as="geometry"/></mxCell><mxCell id="lg0" value="Mulai / selesai" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ad1d8e;strokeColor=#7d1566;fontColor=#ffffff;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="74" width="122" height="24" as="geometry"/></mxCell><mxCell id="lg1" value="Langkah" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=14;fillColor=#fbeaf7;strokeColor=#ad1d8e;fontColor=#2d0b26;fontSize=10;" vertex="1" parent="1"><mxGeometry x="130" y="74" width="122" height="24" as="geometry"/></mxCell><mxCell id="lg2" value="Keputusan" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff7e0;strokeColor=#e0a526;fontColor=#3d2a00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="74" width="122" he