ect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Tagihan &amp; Pembayaran: kirim tagihan ke wali, bukti lewat WEB atau WA" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontStyle=1;fontColor=#7d1566;" vertex="1" parent="1"><mxGeometry x="0" y="8" width="700" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Transfer langsung ke rekening yayasan (tanpa payment gateway). Wali tidak punya akun: akses lewat link bertoken dari WhatsApp." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#6b5766;" vertex="1" parent="1"><mxGeometry x="0" y="44" width="900" height="24" as="geometry"/></mxCell><mxCell id="lg0" value="Mulai / selesai" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ad1d8e;strokeColor=#7d1566;fontColor=#ffffff;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="74" width="122" height="24" as="geometry"/></mxCell><mxCell id="lg1" value="Langkah" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=14;fillColor=#fbeaf7;strokeColor=#ad1d8e;fontColor=#2d0b26;fontSize=10;" vertex="1" parent="1"><mxGeometry x="130" y="74" width="122" height="24" as="geometry"/></mxCell><mxCell id="lg2" value="Keputusan" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff7e0;strokeColor=#e0a526;fontColor=#3d2a00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="74" width="122" height="24" as="geometry"/></mxCell><mxCell id="lg3" value="Gagal / alert" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=14;fillColor=#fde8e8;strokeColor=#d92d20;fontColor=#5c0f0a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="74" width="122" height="24" as="geometry"/></mxCell><mxCell id="lg4" value="Berhasil" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=14;fillColor=#e6f6ec;strokeColor=#2e9e5b;fontColor=#0f3d24;fontSize=10;" v