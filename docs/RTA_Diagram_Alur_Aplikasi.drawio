las di Dashboard diperbarui" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=14;fillColor=#fbeaf7;strokeColor=#ad1d8e;fontColor=#2d0b26;" vertex="1" parent="n5"><mxGeometry x="1342" y="98" width="200" height="84" as="geometry"/></mxCell><mxCell id="n15" value="Selesai" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ad1d8e;strokeColor=#7d1566;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="n4"><mxGeometry x="1582" y="112" width="150" height="56" as="geometry"/></mxCell><mxCell id="n16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6b4a66;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#4f404b;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6b4a66;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#4f404b;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="Tidak" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6b4a66;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#4f404b;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="perbaiki" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6b4a66;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#4f404b;dashed=1;strokeColor=#d92d20;" edge="1" parent="1" source="n9" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="Ya" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6b4a66;endArrow=block;endFill=1;fontS