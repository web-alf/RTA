# Caddy: TLS otomatis (Let's Encrypt, HTTP-01 tetap jalan di balik proxy Cloudflare), web statis, dan proxy /api → API.
# DOMAIN dan CF_TRUSTED_PROXIES (IP Cloudflare, diisi `make cf-ips`) datang dari compose.env.
{
	servers {
		# Percayai header CF-Connecting-IP hanya bila sambungan datang dari IP Cloudflare,
		# sehingga X-Forwarded-For ke API berisi IP pengunjung asli (TRUST_PROXY=1).
		trusted_proxies static {$CF_TRUSTED_PROXIES:private_ranges}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$DOMAIN} {
	encode zstd gzip

	# /api/* → API (awalan /api dibuang; BASE_PATH di API harus kosong)
	handle_path /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
