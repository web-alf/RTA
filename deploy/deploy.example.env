# Salin ke deploy/deploy.local.env (tidak masuk git) lalu isi. Dibaca oleh Makefile.
# Jangan beri komentar di akhir baris nilai (make ikut membaca spasinya).

# --- VPS: IP atau hostname; user root atau ber-sudo (pakai kunci SSH) ---
VPS_HOST=
VPS_USER=root
VPS_PORT=22

# --- Domain & Cloudflare ---
DOMAIN=rta.pelayansantri.com
# IP publik VPS untuk record A (kosong = pakai VPS_HOST, harus berupa IP)
VPS_IP=
# Cloudflare -> domain pelayansantri.com -> Overview -> API -> Zone ID
CF_ZONE_ID=
# Token izin Zone.DNS:Edit + Zone.Zone Settings:Edit, dibatasi ke zone ini saja
CF_API_TOKEN=
# true = awan oranye (proxy Cloudflare), false = DNS saja
CF_PROXIED=true
