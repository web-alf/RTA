# Salin ke deploy/deploy.local.env (tidak masuk git) lalu isi. Dibaca oleh Makefile.

# --- VPS ---
VPS_HOST=203.0.113.10        # IP atau hostname VPS
VPS_USER=root                # root, atau user ber-sudo (kunci SSH, bukan password)
VPS_PORT=22

# --- Domain & Cloudflare ---
DOMAIN=rta.alfatihah.com     # domain/subdomain aplikasi (web + /api)
VPS_IP=203.0.113.10          # IP publik VPS untuk record A (bila VPS_HOST berupa hostname)
CF_ZONE_ID=                  # Cloudflare → domain → Overview → API → Zone ID
CF_API_TOKEN=                # token dengan izin: Zone.DNS:Edit + Zone.Zone Settings:Edit (batasi ke zone ini saja)
CF_PROXIED=true              # true = awan oranye (proxy Cloudflare), false = DNS saja
