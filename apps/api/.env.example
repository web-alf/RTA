# Koneksi database (Supabase: pakai connection string "Session pooler" atau "Direct")
DATABASE_URL=postgres://rta:rta@localhost:5432/rta
# Rahasia JWT (ganti dengan string acak panjang, mis. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=ganti-dengan-rahasia-acak
JWT_REFRESH_SECRET=ganti-dengan-rahasia-acak-lain
ACCESS_TTL=15m
REFRESH_TTL_DAYS=14
# Origin frontend (untuk CORS + cookie)
WEB_ORIGIN=http://localhost:5173
PORT=3000
# Set "true" di produksi (cookie Secure)
COOKIE_SECURE=false

# ---------- Fase 2/3 ----------
# URL frontend publik untuk link tagihan wali (WA)
PUBLIC_WEB_URL=http://localhost:5173
# Rekening yayasan di halaman wali: hanya nilai AWAL; setelah PJ menyimpan di menu Pengaturan, nilai di DB yang dipakai
BANK_NAME=Bank Syariah Indonesia
BANK_ACCOUNT=7xxx xxx xxx
BANK_HOLDER=Yayasan Al-Fatihah
# Folder penyimpanan bukti pembayaran (disk lokal). Ganti adapter untuk Supabase Storage/S3.
STORAGE_DIR=./storage
# Biaya daftar ulang / pindah cabang dan bulan awal tahun pembelajaran (nilai AWAL; diatur di menu Pengaturan)
REREGISTRATION_FEE=100000
ACADEMIC_YEAR_START_MONTH=7
# Matikan penjadwal per jam di dalam API (mis. saat testing, atau di hosting cPanel yang memakai Cron Job → dist/scripts/cron.js)
DISABLE_SCHEDULER=false
# Proxy di depan API (Caddy/nginx/cPanel): jumlah proxy, biasanya 1. Kosong = hanya proxy di mesin yang sama (loopback).
# Menentukan IP asli pengunjung untuk batas login per IP, audit, dan daftar perangkat.
TRUST_PROXY=
