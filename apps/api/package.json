{
  "name": "rta-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun scripts/migrate.ts",
    "db:seed": "bun src/db/seed.ts",
    "db:admin": "bun scripts/create-admin.ts",
    "db:seed-dev": "bun dev/seed-dev.ts",
    "db:demo": "bun dev/demo.ts",
    "db:reset": "bun dev/reset-db.ts && bun scripts/migrate.ts && bun src/db/seed.ts && bun dev/seed-dev.ts && bun dev/demo.ts",
    "db:fresh": "bun dev/reset-db.ts && bun scripts/migrate.ts && bun src/db/seed.ts && bun dev/seed-dev.ts",
    "test:e2e": "bun test/e2e.ts",
    "test:bill": "bun dev/test-bill.ts",
    "cron": "bun scripts/cron.ts",
    "build": "tsc -p tsconfig.build.json",
    "node:start": "node dist/src/main.js",
    "node:migrate": "node dist/scripts/migrate.js",
    "node:seed": "node dist/src/db/seed.js",
    "node:admin": "node dist/scripts/create-admin.js",
    "node:cron": "node dist/scripts/cron.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "^6.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "4.4.0",
    "express": "^4.21.2",
    "hash-wasm": "^4.13.0",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "papaparse": "^5.4.1",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2",
    "@types/bun": "^1.1.14"
  }
}
